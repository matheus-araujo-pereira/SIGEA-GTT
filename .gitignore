# ==============================================================================
# SIGEA-GTT - Root .gitignore
# ==============================================================================

# OS and Environment
.DS_Store
Thumbs.db
*.tmp
*.bak
*.swp
*~

# Secrets & Environment variables (permite apenas o template de exemplo)
.env
*.env
!.env.example
!database/.env.example

# IDEs and Editors
.idea/
*.iws
*.iml
*.ipr
.project
.classpath
.settings/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Maven & Java Build Outputs
**/target/
**/.mvn/wrapper/maven-wrapper.jar
*.class

# Node & Frontend Build Outputs
**/node_modules/
**/dist/
**/.angular/cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.sass-cache/

# Test & Coverage Outputs
**/coverage/
*.dump
*.dumpstream

